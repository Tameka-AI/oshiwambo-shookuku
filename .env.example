# Copy to apps/web/.env.local for local work. Set the real values in Vercel, never in git.
# When both NEXT_PUBLIC_ values are empty the site reads the static catalog in packages/content.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Unused until an admin route exists.
SUPABASE_SERVICE_ROLE_KEY=
